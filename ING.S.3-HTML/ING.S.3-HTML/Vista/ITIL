<html>
<head>
  <meta charset="UTF-8">
  <title>Login PAC</title>
  <link rel="stylesheet" href="../css/logiin.css">
  <script src="../Js/Validacion.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <style>
    .ayuda-btn {
      position: absolute;
      top: 20px;
      right: 20px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 50%;
      width: 45px;
      height: 45px;
      font-size: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .ayuda-btn:hover {
      background-color: #0056b3;
    }
  </style>
</head>

<body>
  <!-- Botón de Ayuda -->
  <button type="button" class="ayuda-btn" data-bs-toggle="modal" data-bs-target="#ayudaModal">❓</button>

  <div class="contenedorform">
    <img src="../Iconos/Log.png" alt="" class="logo">
    <h1 class="title">Iniciar sesión</h1>
    <br>
    <form method="post" action="../Modelo/modelo.php?opcion=2">

      <label for="correo">Correo:</label>
      <input type="text" name="correo" id="correo" size="40">
      <div id="error-correo" class="error" style="color: red; font-size: 0.9em;"></div>
      <br>

      <label for="contrasena">Contraseña:</label>
      <input type="password" name="contrasena" id="contrasena" size="40">
      <div id="error-contrasena" class="error" style="color: red; font-size: 0.9em;"></div>
      <span id="mensaje-error" class="error"></span>
      <br>

      <input type="submit" value="Iniciar sesión">
    </form>

    <br>
    <div class="centrar">
      <p><a href="Recuperar.php" style="color:rgb(6, 88, 5)">¿Olvidaste la contraseña?</a></p>
    </div>
    <br>
    <p>¿Aún no te has registrado?</p>
    <a href="Registro.php" style="color:rgb(1, 31, 0)">Regístrate</a>
  </div>

  <!-- Modal de Ayuda -->
  <div class="modal fade" id="ayudaModal" tabindex="-1" aria-labelledby="ayudaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content p-3">
        <div class="modal-header">
          <h5 class="modal-title" id="ayudaModalLabel">Centro de ayuda</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body" id="contenidoAyuda">

          <!-- Pantalla principal del modal -->
          <div id="menuPrincipal">
            <p>Selecciona una opción:</p>
            <button class="btn btn-primary w-100 mb-2" onclick="mostrarFormulario()">🧾 Solicitar soporte</button>
            <button class="btn btn-success w-100" onclick="mostrarErrores()">🛠️ Centro de ayuda</button>
          </div>

          <!-- Formulario de soporte -->
          <div id="formularioSoporte" style="display:none;">
            <h6>🧾 Formulario de soporte</h6>
            <form id="soporteForm">
              <div class="mb-3">
                <label for="nombre" class="form-label">Nombre</label>
                <input type="text" class="form-control" id="nombre" placeholder="Tu nombre">
              </div>
              <div class="mb-3">
                <label for="correoSoporte" class="form-label">Correo</label>
                <input type="email" class="form-control" id="correoSoporte" placeholder="Tu correo">
              </div>
              <div class="mb-3">
                <label for="mensaje" class="form-label">Descripción del problema</label>
                <textarea class="form-control" id="mensaje" rows="3" placeholder="Describe tu solicitud"></textarea>
              </div>
              <button type="submit" class="btn btn-primary w-100">Enviar solicitud</button>
            </form>
            <button class="btn btn-secondary mt-2 w-100" onclick="volverMenu()">⬅️ Volver</button>
          </div>

          <!-- Centro de ayuda -->
          <div id="centroErrores" style="display:none;">
            <h6>🛠️ Posibles errores y soluciones</h6>
            <ul>
              <li><b>Error:</b> “Correo o contraseña incorrectos.”<br><b>Solución:</b> Verifica mayúsculas o escribe nuevamente tus credenciales.</li>
              <li><b>Error:</b> “El campo correo está vacío.”<br><b>Solución:</b> Asegúrate de llenar todos los campos antes de enviar.</li>
              <li><b>Error:</b> “No carga el sistema.”<br><b>Solución:</b> Revisa tu conexión a Internet o inténtalo más tarde.</li>
            </ul>
            <button class="btn btn-secondary w-100" onclick="volverMenu()">⬅️ Volver</button>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Script para alternar entre secciones -->
  <script>
    function mostrarFormulario() {
      document.getElementById('menuPrincipal').style.display = 'none';
      document.getElementById('formularioSoporte').style.display = 'block';
      document.getElementById('centroErrores').style.display = 'none';
    }
    function mostrarErrores() {
      document.getElementById('menuPrincipal').style.display = 'none';
      document.getElementById('centroErrores').style.display = 'block';
      document.getElementById('formularioSoporte').style.display = 'none';
    }
    function volverMenu() {
      document.getElementById('menuPrincipal').style.display = 'block';
      document.getElementById('centroErrores').style.display = 'none';
      document.getElementById('formularioSoporte').style.display = 'none';
    }
  </script>

</body>
</html>

